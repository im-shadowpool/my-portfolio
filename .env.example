# Visitor counter (Upstash Redis).
# Connecting "Upstash for Redis" to the project in Vercel → Storage adds these
# automatically. For local development run `vercel env pull .env.local`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternatively, from a database created directly at console.upstash.com:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
